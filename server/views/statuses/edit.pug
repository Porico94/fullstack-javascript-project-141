extends ../layout

block content
  h1= t('editStatus')
  form(action=`/statuses/${status.id}` method="POST")
    .mb-3
      label.form-label(for="data_name") #{t('name')}
      input.form-control(type="text" name="data[name]" id="data_name" value=status.name)
    button.btn.btn-primary(type="submit") #{t('edit')}