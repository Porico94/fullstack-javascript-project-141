extends ../layout

block content
  h1= t('editLabel')
  form(action=`/labels/${label.id}` method="POST")
    .mb-3
      label.form-label(for="data_name") #{t('name')}
      input.form-control(type="text" name="data[name]" id="data_name" value=label.name)
    button.btn.btn-primary(type="submit") #{t('edit')}