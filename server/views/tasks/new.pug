extends ../layout

block content
  h1= t('createTask')
  form(action="/tasks" method="POST")
    .mb-3
      label.form-label(for="data_name") #{t('name')}
      input.form-control(type="text" name="data[name]" id="data_name")
    .mb-3
      label.form-label(for="data_description") #{t('description')}
      textarea.form-control(name="data[description]" id="data_description")
    .mb-3
      label.form-label(for="data_statusId") #{t('status')}
      select.form-select(name="data[statusId]" id="data_statusId")
        each status in statuses
          option(value=status.id) #{status.name}
    .mb-3
      label.form-label(for="data_executorId") #{t('executor')}
      select.form-select(name="data[executorId]" id="data_executorId")
        option(value="") #{t('noExecutor')}
        each user in users
          option(value=user.id) #{user.firstName} #{user.lastName}
    .mb-3
      label.form-label(for="data_labels") #{t('labels')}
      select.form-select(name="data[labelIds][]" id="data_labels" multiple)
        each label in labels
          option(value=label.id) #{label.name}
    button.btn.btn-primary(type="submit") #{t('create')}